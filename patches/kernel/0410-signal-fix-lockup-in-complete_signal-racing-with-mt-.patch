Link: https://lore.kernel.org/all/CADGQE7EusFrrSoBnhXhdE20tZJrp1EDe=2623mS8vEMY9hn53A@mail.gmail.com/
Originally-by: Nickolai Zeldovich <nickolai@csail.mit.edu>
Signed-off-by: Oleg Nesterov <oleg@redhat.com>
Link: https://patch.msgid.link/auXxUSMHCh4vA3yV@redhat.com
Tested-by: Nickolai Zeldovich <nickolai@csail.mit.edu>
Reviewed-by: Nickolai Zeldovich <nickolai@csail.mit.edu>
Signed-off-by: Christian Brauner (Amutable) <brauner@kernel.org>
(cherry picked from commit 94ca49563acb36a19fb578499b04c84d5b0a5181)
Signed-off-by: Thomas Lamprecht <t.lamprecht@proxmox.com>
---
 kernel/signal.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/kernel/signal.c b/kernel/signal.c
index ac24e4b169eff44a0a94b1b93ea6b205af104cb1..552f7df677c02b80b690f44c255211f0f2d7c4a4 100644
--- a/kernel/signal.c
+++ b/kernel/signal.c
@@ -1008,7 +1008,8 @@ static void complete_signal(int sig, struct task_struct *p, enum pid_type type)
 		 */
 		t = signal->curr_target;
 		while (!wants_signal(sig, t)) {
-			t = next_thread(t);
+			t = list_next_entry_circular(t, &signal->thread_head,
+							thread_node);
 			if (t == signal->curr_target)
 				/*
 				 * No thread needs to be woken.
